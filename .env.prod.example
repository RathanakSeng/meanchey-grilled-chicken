# Copy to .env.prod on the droplet and fill in. Never commit .env.prod.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Domain (Cloudflare-proxied) ----------------------------------------------
DOMAIN=example.com

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=meanchey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meanchey

# --- API ----------------------------------------------------------------------
ENVIRONMENT=production
# API_DOCS_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Used once, when the superadmin is first seeded.
SUPERADMIN_INITIAL_PASSWORD=change-me
BUSINESS_TIMEZONE=Asia/Phnom_Penh

# Same origin as the UI, so CORS is not needed; keep it aligned with the domain anyway.
CORS_ORIGINS=https://example.com

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://example.com
BOT_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://example.com/api/telegram/webhook
# 1-256 chars of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_AUTO_SET=true
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Host paths ---------------------------------------------------------------
# Directory on the droplet holding origin.pem and origin.key (Cloudflare Origin Certificate).
CERT_DIR=/etc/ssl/cloudflare
