# --- Database ---------------------------------------------------------------
# Inside docker compose, the api/bot services override the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://meanchey:meanchey@localhost:5432/meanchey
# Used only by the test suite. It is dropped and recreated on every test run!
TEST_DATABASE_URL=postgresql+asyncpg://meanchey:meanchey@localhost:5432/meanchey_test

POSTGRES_USER=meanchey
POSTGRES_PASSWORD=meanchey
POSTGRES_DB=meanchey
# Host port for the compose postgres. Change it (and the URLs above) if 5432 is taken.
POSTGRES_HOST_PORT=5432

# --- Auth -------------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Password of the seeded superadmin (username: superadmin). Also the value a superadmin
# self-reset goes back to.
SUPERADMIN_INITIAL_PASSWORD=superadmin

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Also used to validate Mini App initData.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the UI (Mini App). E.g. https://xxxx.trycloudflare.com
MINI_APP_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# How the bot receives updates:
#   webhook  (default) Telegram POSTs to the API at /api/telegram/webhook. No bot process.
#   polling  local dev without a tunnel: `docker compose --profile polling up`.
#   off      no bot at all.
BOT_MODE=webhook
# Webhook mode only. Full public HTTPS URL; port must be 443, 80, 88 or 8443.
# Local testing: your tunnel URL + /api/telegram/webhook, e.g.
#   https://xxxx.ngrok-free.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Webhook mode only. 1-256 chars of A-Z a-z 0-9 _ -. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Register/refresh the webhook automatically on startup (skipped when already up to date).
TELEGRAM_WEBHOOK_AUTO_SET=true
# Discard updates queued at Telegram when the webhook is (re)registered.
TELEGRAM_DROP_PENDING_UPDATES=false

# --- HTTP -------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (not needed when the UI proxies /api).
CORS_ORIGINS=http://localhost:5173
